# ==================================================
# APPLICATION CONFIGURATION
# ==================================================

APP_NAME="Automated Ransomware Containment & IR Orchestrator"
APP_ENV=development
WEBHOOK_SECRET=supersecret123
DATABASE_URL=sqlite:///./ir_orchestrator.db
LOCAL_S3_BUCKET=local_s3_bucket


# ==================================================
# PRODUCTION SAFETY FLAGS
# ==================================================

USE_REAL_EDR=false
USE_REAL_IDP=false
USE_REAL_AWS=false
USE_REAL_TICKETING=false
USE_REAL_NOTIFICATIONS=false

REQUIRE_MANUAL_APPROVAL=true
REAL_ACTION_APPROVAL_CODE=confirm_lab_only

ALLOWED_TEST_HOSTS=DESKTOP-LAB-01,DESKTOP-LAB-02,DESKTOP-LAB-20
ALLOWED_TEST_USERS=himanshu,test.ir.user


# ==================================================
# MICROSOFT DEFENDER FOR ENDPOINT CONFIG
# ==================================================

MDE_TENANT_ID=change_me
MDE_CLIENT_ID=change_me
MDE_CLIENT_SECRET=change_me

MDE_API_BASE_URL=https://api.security.microsoft.com
MDE_AUTHORITY_URL=https://login.microsoftonline.com
MDE_SCOPE=https://api.securitycenter.microsoft.com/.default


# ==================================================
# MICROSOFT GRAPH / AZURE AD CONFIG
# ==================================================

GRAPH_TENANT_ID=change_me
GRAPH_CLIENT_ID=change_me
GRAPH_CLIENT_SECRET=change_me

GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_AUTHORITY_URL=https://login.microsoftonline.com
GRAPH_SCOPE=https://graph.microsoft.com/.default


# ==================================================
# AWS S3 EVIDENCE STORAGE CONFIG
# ==================================================

AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=ap-south-1

S3_BUCKET_NAME=change_me
S3_EVIDENCE_PREFIX=forensic-evidence


# ==================================================
# JIRA / SERVICENOW TICKETING CONFIG
# ==================================================

TICKETING_PROVIDER=mock

JIRA_BASE_URL=change_me
JIRA_EMAIL=change_me
JIRA_API_TOKEN=change_me
JIRA_PROJECT_KEY=IR

SERVICENOW_INSTANCE_URL=change_me
SERVICENOW_USERNAME=change_me
SERVICENOW_PASSWORD=change_me


# ==================================================
# SLACK / MICROSOFT TEAMS NOTIFICATION CONFIG
# ==================================================

NOTIFICATION_PROVIDER=mock

SLACK_WEBHOOK_URL=change_me
TEAMS_WEBHOOK_URL=change_me


# ==================================================
# FORENSIC TOOL CONFIGURATION
# ==================================================

KAPE_ENABLED=false
KAPE_PATH=change_me
KAPE_OUTPUT_DIR=artifacts/kape

VOLATILITY_ENABLED=false
VOLATILITY_PATH=change_me
MEMORY_DUMP_DIR=artifacts/memory


# ==================================================
# SIMULATION CONFIGURATION
# ==================================================

SIMULATION_MODE=true
